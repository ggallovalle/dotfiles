[user]
email={{ .user.email }}
name={{ .user.name }}

[alias]
unstage=reset HEAD --

[core]
editor=nvim
pager=delta
autocrlf=input

[pager]
diff=delta
log=delta
reflog=delta
show=delta

[interactive]
diffFilter=delta --color-only --features=iteractive

[delta]
navigate=true
features=line-numbers decorations
syntax-theme=OneHalfDark
whitespace-error-style=22 reverse

[delta "decorations"]
commit-decoration-style=bold yellow box ul
file-style=bold yellow ul
file-decoration-style=none

[github]
user={{ .user.github }}

[diff]
colorMoved=default

[pull]
rebase=false

[init]
defaultBranch=main

[merge]
conflictStyle=zdiff3
