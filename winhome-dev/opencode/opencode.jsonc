{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M2.7",
  "autoupdate": true,
  "server": {
    "port": 4096
  },
  "default_agent": "build",
  "agent": {
    "build": {
      "permission": {
        "external_directory": {
          "/tmp/**": "allow",
          "$HOME/dev/kbroom/**": "allow",
          "$HOME/.config/**": "allow",
          "$HOME/.local/share/go/**": "allow",
          "$HOME/.local/share/mise/installs/go/latest/**": "allow",
          "$HOME/.luarocks/**": "allow",
          "$HOME/dotfiles/**": "allow",
          "$HOME/.zi/**": "allow",
          "$HOME/.local/share/opencode/**": "allow"
        }
      }
    }
  }
}