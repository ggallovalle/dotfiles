// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "language_models": {
    "openai_compatible": {
      "MiniMax": {
        "api_url": "https://api.minimax.io/v1",
        "available_models": [
          {
            "name": "MiniMax-M2.7",
            "max_tokens": 200000,
            "max_output_tokens": 32000
          }
        ]
      }
    }
  },
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "api_url": "https://api.minimax.io/v1",
      "model": "MiniMax-M2.7",
    }
  },
  "buffer_font_family": "GeistMono Nerd Font",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access",
      },
      "type": "registry",
    },
  },
  "wsl_connections": [
    {
      "distro_name": "archlinux",
      "user": null,
      "projects": [
        {
          "paths": ["/home/kbroom/.zi/plugins/_local---kbroom/./"],
        },
        {
          "paths": ["/home/kbroom/dev/ggallovalle/chante/./"],
        },
        {
          "paths": ["/home/kbroom/dev/ggallovalle/remember/./"],
        },
        {
          "paths": ["/home/kbroom/ghq/github.com/Effect-TS/effect-smol/./"],
        },
      ],
    },
  ],
  "icon_theme": "Catppuccin Macchiato",
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": false,
    },
    "default_model": {
      "provider": "MiniMax",
      "model": "MiniMax-M2.7",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "confirm_quit": false,
  // "ui_font_family": "GeistMono Nerd Font",
  "ui_font_family": "GeistMono Nerd Font",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  // "ui_font_size": 20,
  // "buffer_font_size": 18,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "format_on_save": "off",
  "project_panel": {
    "dock": "left",
    "hide_gitignore": true,
    "hide_hidden": false,
    "auto_open": {
      "on_create": false,
      "on_drop": false,
      "on_paste": false,
    },
  },
  "auto_install_extensions": {
    // ui
    "catppuccin": true,
    "catppuccin-icons": true,
    // languages
    "biome": true,
    "kdl": true,
    "toml": true,
    "git-firefly": true,
  },
  // lsp
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
  },
}
